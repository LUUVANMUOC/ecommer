NODE_ENV=
PORT=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_DIALECT=
JWT_SECRET=

# ===== LƯU TRỮ ẢNH =====
# auto = tự bật Supabase nếu có đủ URL + KEY, ngược lại chỉ lưu đĩa local
STORAGE_DRIVER=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads
SUPABASE_MAX_MB=10
# true = upload lỗi thì báo lỗi luôn (không âm thầm nhận ảnh rồi mất khi deploy)
STORAGE_FAIL_FAST=true