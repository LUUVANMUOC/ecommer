NODE_ENV=
PORT=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_DIALECT=
JWT_SECRET=

# ===== LƯU TRỮ ẢNH =====
# auto = tự bật Supabase nếu có đủ URL + KEY, ngược lại chỉ lưu đĩa local
STORAGE_DRIVER=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads
SUPABASE_MAX_MB=10
# true = upload lỗi thì báo lỗi luôn (không âm thầm nhận ảnh rồi mất khi deploy)
STORAGE_FAIL_FAST=true

# ===== SEPAY / BẢO MẬT WEBHOOK =====
# Khoá mã hoá 32 bytes dạng base64 dùng để mã hoá webhook secret khi lưu DB.
# Tạo khoá: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi khoá phải chạy lại script mã hoá (backend/scripts/maHoaWebhookSecret.js).
SEPAY_ENC_KEY=

# Secret của webhook cấp Sàn (các webhook Shop/ĐVVC lưu riêng trong DB)
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_BA_XID=
SEPAY_ENV=sandbox